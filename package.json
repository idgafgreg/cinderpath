{
  "name": "cinderpath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An atmospheric mobile-first endless runner. Carry the last light, earn every unlock.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test game/tests/*.test.js runner/tests/*.test.js && node game/tests/fixture-walk.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}
